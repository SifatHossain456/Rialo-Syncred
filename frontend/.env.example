# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Deployed contract address (after running: cd contracts && npm run deploy:goerli)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_your_deployed_contract_address

# Optional: Custom RPC URLs
NEXT_PUBLIC_GOERLI_RPC=https://rpc.ankr.com/eth_goerli
NEXT_PUBLIC_SEPOLIA_RPC=https://rpc.ankr.com/eth_sepolia
